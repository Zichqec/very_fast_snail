//splice together two radio dialogues for a neat transition
//arg 0 is the first dialogue, arg 0 is the second
//this is kinda extremely dodgy, it's made with a lot of assumptions about how we will write our snail, it is not suitable for general use
DialogueTransition
{
	_talk1 = _argv[0]
	_talk2 = _argv[1]
	LOGGING("_talk2 at first: %(_talk2)")
	_output = ""
	
	//Get a list of all the tags
	_tags1 = SakuraScooper(_talk1)
	_tags2 = SakuraScooper(_talk2)
	_bigballoon = 0
	if !(ASEARCH("\b[22]",_tags1) == -1 && ASEARCH("\b[22]",_tags2) == -1); _bigballoon = 1
	
	//Remove tags and replace with C_BYTE1
	foreach _tags1; _tag
	{
		_talk1 = REPLACE(_talk1,_tag,C_BYTE1,1)
	}
	foreach _tags2; _tag
	{
		_talk2 = REPLACE(_talk2,_tag,C_BYTE1,1)
	}
	
	
	
	_startlen = STRLEN(_talk1)
	_pos1 = RAND(50) + 20
	_i = 0
	while SUBSTR(_talk1,_pos1,1) == " " || SUBSTR(_talk1,_pos1,1) == C_BYTE1 || _pos1 > _startlen
	{
		_pos1 = RAND(50) + 20
		
		_i++
		if _i > 5000; break
	}
	
	_talk1 = SUBSTR(_talk1,0,_pos1)
	foreach _tags1; _tag
	{
		_talk1 = REPLACE(_talk1,C_BYTE1,_tag,1)
	}
	_output += _talk1
	_output += "%(emdash)\n\n \f[default]\f[italic,1]%(emdash)%(gshhk)%(emdash)\f[italic,default]\n\n %(emdash)"
	
	_endlen = STRLEN(_talk2)
	_pos2 = RAND(50) + 20
	_i = 0
	while SUBSTR(_talk2,_pos2,1) == " " || SUBSTR(_talk2,_pos2,1) == C_BYTE1 || _pos2 > _endlen
	{
		_pos2 = RAND(50) + 20
		
		_i++
		if _i > 5000; break
	}
	
	_talk2first = SUBSTR(_talk2,0,_pos2)
	_talk2last = ERASE(_talk2,0,_pos2)
	
	_amt = LetterCount(_talk2first,C_BYTE1)
	_talk2tags = ""
	for _i = 0; _i < _amt; _i++
	{
		_talk2tags += C_BYTE1
	}
	
	//Put tags back into place
	
	foreach _tags2; _tag
	{
		if C_BYTE1 _in_ _talk2tags
		{
			//Don't carry over linebreaks from first section
			if _tag == "\n" || "\_b" _in_ _tag; _talk2tags = REPLACE(_talk2tags,C_BYTE1,"",1) //TODO test that image tags for snailpic and slugpic now work as intended and aren't placed awkwardly...
			else; _talk2tags = REPLACE(_talk2tags,C_BYTE1,_tag,1)
		}
		else; _talk2last = REPLACE(_talk2last,C_BYTE1,_tag,1)
	}
	
	//If nothing comes out, just grab the whole thing, it's better than going to silence...
	_talk2 = _talk2tags + _talk2last
	if STRLEN(_talk2last) <= 5; _talk2 = _argv[1]
	_output += _talk2
	
	//_output = REPLACE(_output," %(emdash)\w8\w8","%(emdash)\w8\w8") //bandaid patch because sometimes it breaks on a space... i should probably just try to fix this tho cuz it shouldn't happen - but tbh maybe this is the better fix lol. less looping... i'll think about it. and it allows breaking between words! - I think this one was assuming autopause, but autopause won't come into effect until later...
	_output = REPLACE(_output," %(emdash)\n\n","%(emdash)\n\n")
	_output = REPLACE(_output,"%(emdash) ","%(emdash)")
	
	if _bigballoon
	{
		_output = REPLACE(_output,"\1\b[20]","\1\b[22]")
	}
	
	_output
}

//Argument 0: The string to check
//Argument 1: The letter(s) to search for (case sensitive)
LetterCount
{
    _input = _argv[0]
    _let = _argv[1]
    _replaced = REPLACE(_input,_let,"")
    _num = STRLEN(_input) - STRLEN(_replaced)
    if STRLEN(_let) > 1; _num /= STRLEN(_let)
    _num
}

