//Quick seeded choice function... for daily choices like what charity event is going on
TodaysChoice
{
	//Goal of the variance here is to make it so that even if they have the same number of choices, they won't pop out the same options all the time... I am *hoping* that in order for two different choices to draw the same thing every time, they would have to have both the same array length AND the same string length, which is very unlikely... I hope, anyway
	//ughhhhh this wont work for the charityevent ones........ damn
	_len = 0
	foreach _argv; _arg
	{
		_len += STRLEN(TOSTR(_arg))
	}
	_seedstr = TOSTR(TodaysSeed)
	_variance = SUBSTR(_seedstr,_len % STRLEN(_seedstr),1)
	_variance = TOINT(_variance)
	
	_pick = (TodaysSeed + _variance) % _argc
	_argv[_pick]
}

//It's like the above, but if it's multiple different arrays of the same length they should match.......................
TodaysChoices
{
	_pick = TodaysSeed % _argc
	_argv[_pick]
}

yearweek
{
    //Get the current day of the year (This was previously using my yearday function, so I'm adding a 1 here to compensate...)
    _days = GETTIME[7] + 1
    
    //Get the number of days into the current week that we are
    _trailingdays = 0
    while weekday - _trailingdays >= 0
    {
        _trailingdays++
    }
    
    //Get the number of weeks minus leading and trailing days
    _days -= _trailingdays
    _weeks = _days / 7
    _leadingdays = _days % 7
    
    //Add in the trailing weeks
    if _leadingdays > 0; _weeks++
    if _trailingdays > 0; _weeks++

    //Handles week 53
    if _weeks == 53
    {
        _daysleft = 31 - day
        if _daysleft + _trailingdays < 7; _weeks = 1
    }
    _weeks
}

