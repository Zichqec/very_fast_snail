racetime : all
{
	_base = 1000
	if GETTYPE(_argv[0]) == 1 && _argv[0] > 0; _base = _argv[0]
	
	//The base time is how many millimeters the race is, and a real world snail averages like 1mm per second
	//These are Very Fast Snails, they go a goodly bit faster. They got rockets and stuff lol. It also varies a lot based on terrain, etc.
	//I think... divide by 10 (assume base speed of 1cm per second), and then give it a variance of + or - 50%?
	
	_base = _base / 10
	_half = _base / 2
	_rand = RAND(_base)
	_time = _half + _rand //half guaranteeing at least it'll be 50% of the starting value, and _rand giving it the range of anywhere from 50%-150%...
	
	_minutes = _time / 60
	_seconds = _time % 60
	
	if _minutes != 0
	{
		_s = "s"; if _minutes == 1; _s = ""
		"%(_minutes) minute%(_s)"
	}
	
	if _seconds != 0
	{
		if _minutes != 0; " and " //this is awkward but i can't come up with a better way???
		_s = "s"; if _seconds == 1; _s = ""
		"%(_seconds) second%(_s)"
	}
	else
	{
		" flat"
	}
	
	/*
	_mins = RAND(5) + 4
	_seconds = RAND(60)
	
	if _seconds == 0
	{
		"%(_mins) minutes flat"
	}
	else
	{
		_s = "s"; if _seconds == 1; _s = ""
		"%(_mins) minutes and %(_seconds) second%(_s)"
	}
	*/
}

