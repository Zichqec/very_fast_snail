//Get a quick index for other functions to do with weather comments...
//Damn, do we want to make sure this changes to something new every day, tho? Maybe I'd be better off handling it in boot. Something to consider... TODO
// TodaysWeather
// {
	// TodaysChoice((0,1,2,3,4,5,6))
// }

MakeWeather
{
	_types = (0,1,2,3,4,5,6)

	if !ISVAR("Weather.Yesterday"); Weather.Yesterday = ANY(_types)
	else; Weather.Yesterday = Weather.Today

	if !ISVAR("Weather.Today"); Weather.Today = ANY(_types)
	else; Weather.Today = Weather.Tomorrow

	//Currently I don't plan to make it avoid duplication... but if I change my mind that has to happen here
	//Nah, don't make it avoid that, I already turned that into content lol
	Weather.Tomorrow = ANY(_types)
}

