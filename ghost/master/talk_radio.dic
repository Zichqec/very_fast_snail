//This can be both jockeys together. Should it get double ads...? hm. depends how easy they are to write lol
Ads.ASMR : nonoverlap_pool
{
	_candidates = ASMR.ad_reads
	
	//This setup is so that we can avoid writing all those tags for each ASMR dialogue, but also so that it doesn't break chains...
	for _i = 0; _i < ARRAYSIZE(_candidates); _i++
	{
		_candidates[_i] = "\1\b[22]\f[italic,1]\f[color,disable]" + _candidates[_i]
		if "\e" _in_ _candidates[_i]; _candidates[_i] = REPLACE(_candidates[_i],"\e","\f[color,default]\f[italic,default]\e")
		else; _candidates[_i] += "\f[color,default]\f[italic,default]"
	}
	parallel _candidates
}

